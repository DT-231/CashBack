# Mọi biến môi trường của backend (đọc MỘT lần ở backend/app/core/config.py).
# Sao chép thành .env (KHÔNG commit). Biến thật trong môi trường thắng file .env.

# --- Chế độ dev: dữ liệu giả, KHÔNG gọi Shopee thật (nên bật khi phát triển/test) ---
MOCK=0
LOG_LEVEL=INFO

# --- Affiliate / link ---
# Affiliate ID (dashboard -> Hồ sơ). Nằm trong link dashboard tạo: utm_source=an_<số này>
SHOPEE_AFF_ID=
# Format ĐÃ VERIFY với dashboard VN ngày 2026-11-26. Để trống = dùng mặc định (khuyến nghị).
#   https://shopee.vn/universal-link/product/{shop_id}/{item_id}?utm_source=an_{aff_id}&utm_medium=affiliates&utm_campaign={campaign}&utm_content={sub_id}
LINK_TEMPLATE=
# utm_campaign. Dashboard mặc định "-".
AFF_CAMPAIGN=-
# Tự bù sub_id đủ 5 slot ngăn bằng "-". Đặt 0 để dùng nguyên văn.
SUB_ID_PAD=1
# Khóa HMAC ký sub_id v1, >= 16 byte ngẫu nhiên. Đổi khóa = mọi sub_id cũ thành "chữ ký sai". BẮT BUỘC cho /api/v1/agent/links.
SUBID_SECRET=

# --- Tool API (Muse AI) ---
# Khóa khởi tạo cho Tool API (Bearer). Bắt buộc khi HOST không phải localhost. Khóa khác cấp qua bảng agent_keys.
AGENT_API_KEY=
# Origin được phép gọi từ trình duyệt, ngăn bằng dấu phẩy. Để trống = tắt CORS (Tool API là server-to-server).
CORS_ORIGINS=

# --- Server ---
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE=

# --- Đồng bộ đơn (worker) ---
# Mỗi lần sync quét lại bấy nhiêu ngày gần nhất (đơn đổi trạng thái sau khi mua: hoàn thành/hủy/trả)
SYNC_DAYS=60
# Ví chỉ chuyển 'chờ xác nhận' -> 'rút được' khi lần sync đơn gần nhất là ok VÀ không cũ hơn bấy nhiêu giờ
SYNC_MAX_AGE_HOURS=24

# --- Click (/go/{code}) ---
# Khóa HMAC để băm IP và User-Agent của người bấm link (chống gian lận, không lưu IP thô). Rỗng = không lưu.
# BẮT BUỘC khi HOST không phải localhost (server từ chối khởi động nếu thiếu), vì dữ liệu này không khôi phục được.
IP_SALT=
# 1 khi chạy sau Cloudflare Tunnel: tin header CF-Connecting-IP làm IP người dùng. Mặc định 0 (dùng IP kết nối).
TRUST_PROXY_HEADERS=0

# --- Đăng nhập (module auth) ---
# Khóa ký access token, >= 32 ký tự ngẫu nhiên (vd: python -c "import secrets;print(secrets.token_urlsafe(48))"). Không commit.
JWT_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
# 1 = bắt xác minh email mới cho đăng nhập (chỉ bật khi đã có gửi email, T-011)
REQUIRE_EMAIL_VERIFY=0

# --- Giới hạn tốc độ (Postgres, fail-open nếu DB giới hạn gặp lỗi) ---
# Sau Cloudflare Tunnel/proxy BẮT BUỘC đặt TRUST_PROXY_HEADERS=1 và HOST=127.0.0.1 (khởi động bị từ chối nếu TRUST_PROXY_HEADERS=1 mà HOST lắng nghe ngoài localhost); nếu không mọi người dùng có chung một IP (127.0.0.1) và dùng chung một bộ đếm, /go sẽ chặn khách thật.
# Bí mật chung với BFF Next.js (T-017), >= 16 ký tự, CÙNG giá trị với BFF_SHARED_SECRET của frontend. Có nó thì backend tin X-Visitor-IP (IP thật do BFF lấy từ CF-Connecting-IP) để giới hạn tốc độ theo từng khách; để trống thì header đó bị bỏ qua và mọi khách qua BFF dùng chung một bộ đếm (127.0.0.1). Tạo: python3 -c "import secrets;print(secrets.token_urlsafe(32))". Không commit giá trị thật.
BFF_SHARED_SECRET=
# 1 khi web đi qua BFF Next.js: thiếu/ngắn BFF_SHARED_SECRET sẽ bị cảnh báo lúc khởi động và /health báo degraded.
BFF_ENABLED=0
RL_ENABLED=1
# Đăng ký theo IP trong một giờ
RL_REGISTER_PER_HOUR=5
# Đăng nhập theo IP trong một phút
RL_LOGIN_PER_MINUTE=10
# Đăng nhập theo email trong 15 phút (email được băm trước khi lưu)
RL_LOGIN_PER_EMAIL_15MIN=10
# Làm mới phiên theo IP trong một phút
RL_REFRESH_PER_MINUTE=30
# Redirect /go theo IP trong một phút
RL_GO_PER_MINUTE=120

# --- Postgres ---
# Dev: make db-up (cổng 5433). Neon/Supabase: dán connection string, dạng postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://cashback:cashback_dev@127.0.0.1:5433/cashback

# --- Shopee (chỉ backend/app/integrations/shopee dùng) ---
# Cookie của shopee.vn (dùng cho search). Lấy: login shopee.vn -> F12 -> Network -> F5
#   -> 1 request bất kỳ tới shopee.vn -> Request Headers -> copy dòng Cookie
# KHÁC với SHOPEE_COOKIE bên dưới (cookie của affiliate.shopee.vn, chỉ dùng cho dashboard). KHÔNG trộn 2 cái.
SHOPEE_WEB_COOKIE=
# Header af-ac-enc-dat lấy từ chính request shopee.vn ở trên (nếu có)
SHOPEE_WEB_ENC_DAT=
# Cookie phiên affiliate.shopee.vn (chỉ dashboard/báo cáo): DevTools -> Network -> request bất kỳ -> header Cookie. Sống 7-15 ngày.
# Không bao giờ commit/log. (Tên cũ AFF_COOKIE vẫn được đọc.)
SHOPEE_COOKIE=
# Header chống bot copy từ request thật (có thể để trống rồi thử trước)
SHOPEE_AF_AC_ENC_DAT=
# Proxy IP nhà nếu IP bị chặn (vd http://user:pass@1.2.3.4:8080)
SHOPEE_PROXY=
# User-Agent tùy chỉnh (mặc định Chrome 157 macOS)
SHOPEE_UA=
# Endpoint search nội bộ (đổi khi Shopee đổi)
SHOPEE_SEARCH_URL=https://shopee.vn/api/v4/search/search_items
# Cache kết quả search/dashboard, giây. 0 = tắt.
SHOPEE_CACHE_TTL=300

# --- Tìm sản phẩm ---
# auto = feed -> api -> browser. Ép 1 nguồn: feed|api|browser
SEARCH_ENGINE=auto
# File feed đã chuẩn hóa: python3 backend/scripts/feed_import.py <file_tải_về>.csv -o feed.csv
FEED_FILE=
# Engine browser (Playwright): file phiên từ backend/scripts/login_save_state.py, và chạy ẩn hay không
PW_STATE=
HEADLESS=1
