# --- Bắt buộc ---
# Affiliate ID của bạn (dashboard -> Hồ sơ). Con số này nằm ngay trong link dashboard tạo ra: utm_source=an_<số này>
SHOPEE_AFF_ID=

# --- Định dạng link affiliate (ĐÃ VERIFY với dashboard VN ngày 2026-11-26) ---
# Dashboard trả link dài dạng:
#   https://shopee.vn/universal-link/<slug>-i.<shop>.<item>?utm_source=an_<aff_id>&utm_medium=affiliates&utm_campaign=-&utm_content=<sub1>-<sub2>-<sub3>-<sub4>-<sub5>
# Không cần slug, dùng thẳng path /product/{shop_id}/{item_id} — Shopee vẫn 301 + gắn uls_trackid.
LINK_TEMPLATE=https://shopee.vn/universal-link/product/{shop_id}/{item_id}?utm_source=an_{aff_id}&utm_medium=affiliates&utm_campaign={campaign}&utm_content={sub_id}

# Tên chiến dịch (utm_campaign). Dashboard mặc định là "-" nếu để trống.
AFF_CAMPAIGN=-

# Tự bù sub_id cho đủ 5 slot ngăn bằng "-" (giống dashboard: testSubid1----).
# Muốn dùng nguyên văn sub_id thì đặt 0.
SUB_ID_PAD=1

# --- Cookie phiên Shopee (BẮT BUỘC nếu bị chặn 403 khi search) ---
# DevTools -> Network -> request search_items -> copy nguyên header Cookie
# Dùng cho revenue.py (đọc dashboard) + engine api. Cookie của affiliate.shopee.vn.
SHOPEE_COOKIE=

# Header chống bot, cũng copy từ request thật (có thể để trống rồi thử trước)
SHOPEE_AF_AC_ENC_DAT=

# --- Proxy (nếu IP nhà bị Shopee chặn) ---
# Ví dụ: http://user:pass@1.2.3.4:8080
SHOPEE_PROXY=

# --- Server ---
PORT=8080
HOST=127.0.0.1
# Điền domain thật nếu bạn đưa service lên VPS, để có thêm click_url trong response
PUBLIC_BASE=

# --- Nguồn tìm sản phẩm ---
# auto = feed -> api -> browser (cái nào chạy được thì thôi). Muốn ép 1 nguồn: feed|api|browser
SEARCH_ENGINE=auto

# File feed đã chuẩn hoá bằng feed_import.py. Bỏ trống = không dùng feed.
# Lấy feed: dashboard affiliate -> Product Feed / Báo cáo -> Export CSV
# Rồi: python3 feed_import.py <file_vua_tai>.csv -o feed.csv
FEED_FILE=

# --- Dữ liệu ---
# DB_PATH=./data/links.db
# IP_SALT=doi_thanh_gi_do

# --- Dev: trả dữ liệu giả, không gọi Shopee ---
MOCK=0
