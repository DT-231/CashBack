# Mọi biến môi trường của backend (đọc MỘT lần ở backend/app/core/config.py).
# Sao chép thành .env (KHÔNG commit). Biến thật trong môi trường thắng file .env.

# --- Chế độ dev: dữ liệu giả, KHÔNG gọi Shopee thật (nên bật khi phát triển/test) ---
MOCK=0
LOG_LEVEL=INFO

# --- Affiliate / link ---
# Affiliate ID (dashboard -> Hồ sơ). Nằm trong link dashboard tạo: utm_source=an_<số này>
SHOPEE_AFF_ID=
# Format ĐÃ VERIFY với dashboard VN ngày 2026-11-26. Để trống = dùng mặc định (khuyến nghị).
#   https://shopee.vn/universal-link/product/{shop_id}/{item_id}?utm_source=an_{aff_id}&utm_medium=affiliates&utm_campaign={campaign}&utm_content={sub_id}
LINK_TEMPLATE=
# utm_campaign. Dashboard mặc định "-".
AFF_CAMPAIGN=-
# Tự bù sub_id đủ 5 slot ngăn bằng "-". Đặt 0 để dùng nguyên văn.
SUB_ID_PAD=1
# Khóa HMAC ký sub_id v1, >= 16 byte ngẫu nhiên. Đổi khóa = mọi sub_id cũ thành "chữ ký sai". BẮT BUỘC cho /api/v1/agent/links.
SUBID_SECRET=

# --- Tool API (Muse AI) ---
# Khóa khởi tạo cho Tool API (Bearer). Bắt buộc khi HOST không phải localhost. Khóa khác cấp qua bảng agent_keys.
AGENT_API_KEY=
# Origin được phép gọi từ trình duyệt, ngăn bằng dấu phẩy. Để trống = tắt CORS (Tool API là server-to-server).
CORS_ORIGINS=

# --- Server ---
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE=

# --- Postgres ---
# Dev: make db-up (cổng 5433). Neon/Supabase: dán connection string, dạng postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://cashback:cashback_dev@127.0.0.1:5433/cashback

# --- Shopee (chỉ backend/app/integrations/shopee dùng) ---
# Cookie phiên affiliate.shopee.vn: DevTools -> Network -> request bất kỳ -> header Cookie. Sống 7-15 ngày.
# Không bao giờ commit/log. (Tên cũ AFF_COOKIE vẫn được đọc.)
SHOPEE_COOKIE=
# Header chống bot copy từ request thật (có thể để trống rồi thử trước)
SHOPEE_AF_AC_ENC_DAT=
# Proxy IP nhà nếu IP bị chặn (vd http://user:pass@1.2.3.4:8080)
SHOPEE_PROXY=
# User-Agent tùy chỉnh (mặc định Chrome 157 macOS)
SHOPEE_UA=
# Endpoint search nội bộ (đổi khi Shopee đổi)
SHOPEE_SEARCH_URL=https://shopee.vn/api/v4/search/search_items
# Cache kết quả search/dashboard, giây. 0 = tắt.
SHOPEE_CACHE_TTL=300

# --- Tìm sản phẩm ---
# auto = feed -> api -> browser. Ép 1 nguồn: feed|api|browser
SEARCH_ENGINE=auto
# File feed đã chuẩn hóa: python3 backend/scripts/feed_import.py <file_tải_về>.csv -o feed.csv
FEED_FILE=
# Engine browser (Playwright): file phiên từ backend/scripts/login_save_state.py, và chạy ẩn hay không
PW_STATE=
HEADLESS=1
